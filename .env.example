# Public site URL, used for canonical URLs, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://example.com

# Tap-to-call phone number. Leave unset to hide all call-now UI.
# Accepts a display format; digits are normalized automatically for tel: links.
NEXT_PUBLIC_BUSINESS_PHONE=

# Lead delivery (Resend). All three must be set for the quote form to send email.
RESEND_API_KEY=
LEAD_DESTINATION_EMAIL=
LEAD_FROM_EMAIL=

# Secret used to hash IP addresses for in-memory rate limiting. Any random string.
RATE_LIMIT_SECRET=

# Lead persistence (Supabase). Both required to save quote submissions to the
# `leads` table via the `submit-lead` Edge Function, independent of email
# delivery status. SUPABASE_ANON_KEY is the public anon key, not a secret —
# the Edge Function holds the service-role key internally.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to skip loading any
# analytics script or firing any tracking events.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
